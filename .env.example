# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ: AI-ТИМЛИД «МАКС» (WEB APP + ЧАТ-БОТ В МЕССЕНДЖЕРЕ)
# ==============================================================================
# Скопируйте этот файл в .env перед запуском:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. КЛЮЧ GOOGLE GEMINI API (Обязательно для работы живого искусственного интеллекта)
# ------------------------------------------------------------------------------
# Получите бесплатно без привязки банковской карты:
# https://aistudio.google.com/app/apikey -> Нажмите "Create API key"
GEMINI_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. ПОРТ ВЕБ-СЕРВЕРА
# ------------------------------------------------------------------------------
# Порт, на котором поднимается веб-приложение Mini App (по умолчанию 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 3. ТОКЕН БОТА ДЛЯ МЕССЕНДЖЕРА (Выберите МАКС или Telegram, или укажите оба)
# ------------------------------------------------------------------------------
# Вариант А: Отечественный мессенджер МАКС (https://dev.max.ru)
BOT_TOKEN="max_bot_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Вариант Б: Telegram (получите у официального бота @BotFather командой /newbot)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz12345678"

# ------------------------------------------------------------------------------
# 4. ПУБЛИЧНЫЙ URL ВАШЕГО WEB APP (Для кнопки запуска Mini App прямо в чате)
# ------------------------------------------------------------------------------
# Мессенджер МАКС и Telegram требуют обязательный защищенный протокол HTTPS:
# - В AI Studio это ваш публичный адрес (уже подставлен):
WEBAPP_URL="https://ais-dev-uh6zjs2xamoeuueivmctfd-89586925952.europe-west1.run.app"
# - При тестировании локального ПК через ngrok: "https://xxxx-xx-xx-xx.ngrok-free.app"

# ------------------------------------------------------------------------------
# 5. ДОВЕРИЕ РОССИЙСКИМ СЕРТИФИКАТАМ МИНЦИФРЫ РФ
# ------------------------------------------------------------------------------
# Обязательно для подключения к платформе МАКС (dev.max.ru) внутри контейнера Docker
NODE_TLS_REJECT_UNAUTHORIZED=0
